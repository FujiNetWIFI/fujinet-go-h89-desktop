# Build trees. The negation matters: build-aux/ is SOURCE (flatpak manifests,
# the NSIS installer script), and "build*/" swallows it -- new manifests then
# never show up as untracked and quietly go missing from CI.
build*/
!build-aux/

# Provisioned dependencies. cmake/Dependencies.cmake fetches these at their
# pinned commits, so they are build output, not source -- and committing them
# as bare gitlinks (which `git add -A` will happily do once they exist
# locally) is worse than not tracking them at all.
/third_party/

# FujiNet runtime build tree (tools/fujinet/build-fujinet-desktop.sh).
tools/fujinet/work/

# System ROMs. The H89 monitors, the H-17 ROM and the H19 font are
# copyrighted and never committed; a developer may drop them here (loose, or
# MAME's own h89.zip and heath_tlb.zip) for -DWITH_H89_ROMS=ON builds and the
# no_embedded_roms checks (see COMPLIANCE.md).
tools/roms/*
!tools/roms/embed-roms.py
!tools/roms/README.md

# Boot and data disks fetched or built for local end-to-end runs
# (tools/disks/fetch-disks.sh). Operating system disks are copyrighted and
# never committed.
tools/disks/images/
*.h8d
*.h17
*.h17raw
*.rawdisk
*.tmpdisk
*.imd
*.IMD
*.td0
*.TD0
*.mmsdisk
*.logdisk

.cache/
compile_commands.json
.flatpak-builder/
__pycache__/
*.pyc
*.o
